<RCC>
    <qresource prefix="/">
        <file>qml/AboutWindow.qml</file>
        <file>qml/ClipboardManager.qml</file>
        <file>qml/FileActionsMenu.qml</file>
        <file>qml/FileManager.qml</file>
        <file>qml/FindexDefaultView.qml</file>
        <file>qml/FindexFooter.qml</file>
        <file>qml/FindexGridView.qml</file>
        <file>qml/FindexHeader.qml</file>
        <file>qml/FindexListView.qml</file>
        <file>qml/FindexLogView.qml</file>
        <file>qml/FindexMenuBar.qml</file>
        <file>qml/FindexSearchBar.qml</file>
        <file>qml/FindexTableView.qml</file>
        <file>qml/main.qml</file>
    </qresource>
    <qresource prefix="/findex">
        <file>js/utils.js</file>
        <file>js/file-style.js</file>
        <file>js/view.js</file>
    </qresource>
    <qresource prefix="/translations">
        <file alias="findex_zh_CN.qm">../build/src/findex_zh_CN.qm</file>
        <file alias="findex_fr_FR.qm">../build/src/findex_fr_FR.qm</file>
    </qresource>
    <qresource>
        <file>fonts/fa-solid-900.ttf</file>
        <file>fonts/MaterialIcons-Regular.ttf</file>
        <file>fonts/MaterialSymbolsOutlined-Regular.ttf</file>
        <file>fonts/MaterialSymbolsOutlined-Light.ttf</file>
        <file>fonts/MaterialSymbolsOutlined_Filled-Regular.ttf</file>
    </qresource>
    <qresource>
        <!-- <file>images/scrollbar.png</file> -->
    </qresource>
</RCC>